# Node.js / AWS Lambda - root .gitignore

# Node modules
node_modules/
.pnp/
.pnp.js

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Build output
dist/
build/
lib/
out/
.bundle/
.tmp/
tmp/
temp/

# Serverless & SAM artifacts
.serverless/
.aws-sam/
.aws-sam-build/
*.zip

# Dependency directories for lambda packaging
.node_modules/

# Coverage
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo

# Testing
jest-cache/
.cache/
.vitest/
playwright-report/

# Environment files (keep examples)
.env
.env.* 
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Editor directories and files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Package manager files and caches
.cache/
.npm/
pnpm-lock.yaml

# Misc
*.swp
*~
.project
.settings/
.history/
.eslintcache